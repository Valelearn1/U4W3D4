								"users",
								"{{userId}}"
							]
						},
						"description": "Richiede un token valido (qualsiasi ruolo). Risponde con UserResponseDTO (senza password)."
					}
				},
				{
					"name": "PUT aggiorna utente (se stesso o ADMIN)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nome\": \"Mario Rossi (aggiornato)\",\n    \"email\": \"mario.rossi@example.com\",\n    \"password\": \"Password1!\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/users/{{userId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"users",
								"{{userId}}"
							]
						},
						"description": "Un utente può aggiornare SOLO il proprio profilo; un ADMIN può aggiornare chiunque.\n- utente su id altrui -> 403\nLa password viene ri-hashata. Il campo ruolo non è presente nel DTO, quindi non è modificabile qui."
					}
				},
				{
					"name": "PATCH assegna ruolo (solo ADMIN)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{adminToken}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"ruolo\": \"ADMIN\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/users/{{userId}}/role",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"users",
								"{{userId}}",
								"role"
							]
						},
						"description": "Promuove/cambia il ruolo di un utente. @PreAuthorize(\"hasRole('ADMIN')\").\n- valori ammessi: USER, ADMIN (case-insensitive)\n- valore non valido (es. \"PIPPO\") -> 400\n- token USER -> 403"
					}
				},
				{
					"name": "DELETE utente (se stesso o ADMIN)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{adminToken}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/users/{{userId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"users",
								"{{userId}}"
							]
						},
						"description": "Un utente può cancellare SOLO il proprio profilo; un ADMIN può cancellare chiunque. Risponde 204 No Content. Cancella prima i BlogPost collegati (FK)."
					}
				}
			]
		},
